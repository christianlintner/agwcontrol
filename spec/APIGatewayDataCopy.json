{
  "swagger" : "2.0",
  "info" : {
    "description" : "Throughout the Lifecycle of the webMethods API Gateway version, periodic upgrades of Datastore and Dashboard are performed by using the Datacopy feature. To upgrade from one version of Elasticsearch to the next one, it is crucial to move the core and transactional data from the previous version to the target version.",
    "version" : "10.15",
    "title" : "API Gateway Data copy"
  },
  "host" : "localhost:5555",
  "basePath" : "/rest/apigateway",
  "schemes" : [ "http" ],
  "consumes" : [ "application/json", "application/json" ],
  "produces" : [ "application/json", "application/json" ],
  "paths" : {
    "/migrate/datacopy" : {
      "post" : {
        "description" : "Triggers a datacopy action to transfer the core and transactional data from the source datastore to the target datastore and also update the target dashboard configuration. Copying data to a single node is sufficient if the destination datastore is clustered.  While dashboard availability is not required, we must ensure that the source and target datastores are accessible. There is a rollback option available in case the upgrade fails or is unsuccessful. The client is redirected to the source Datastore, and the configuration update is undone. After that, we must clean up the target datastore and begin the data copy procedure over. By using a webhook, you can automate the status delivery process and receive timely status updates on the data copy process, For example, you can use Microsoft Teams to get the timely status of the data copy process whenever the webMethods API Gateway undergoes a change. ",
        "operationId" : "datacopy",
        "consumes" : [ "application/json" ],
        "produces" : [ "application/json" ],
        "parameters" : [ {
          "in" : "body",
          "name" : "body",
          "description" : "",
          "required" : true,
          "schema" : {
            "$ref" : "#/definitions/MigrateDatacopyRequest"
          },
          "x-examples" : {
            "application/json" : "{\"targetCoreESEndpointConfig\":{\"endpoint\":\"http://ES-target-core:7200\",\"userName\":\"\",\"password\":\"\"},\"targetEventsAndLogsESEndpointConfig\":{\"endpoint\":\"http://ES-target-events:8200\",\"userName\":\"\",\"password\":\"\"},\"targetDashboardConfig\":{\"endpoint\":\"http://Kibana-target:5601\"},\"webhookConfig\":{\"endpoint\":\"https://IBM.webhook.office.com/webhookb2/389f20cc-7a1e-4748-a831-169b0f186370@d9662eb9-ad98-4e74-a8a2-04ed5d544db6/IncomingWebhook/d5224d8d40704d4398f41f11c9f81ea9/6853d033-7782-4044-9d13-1390c00393a6\",\"userName\":\"\",\"password\":\"\",\"template\":\"{\\\"@type\\\":\\\"MessageCard\\\",\\\"@context\\\":\\\"http://schema.org/extensions\\\",\\\"themeColor\\\":\\\"0076D7\\\",\\\"summary\\\":\\\"Datacopylog\\\",\\\"sections\\\":[{\\\"activityTitle\\\":\\\"Datacopystatus\\\",\\\"activitySubtitle\\\":\\\"APIGw\\\",\\\"activityImage\\\":\\\"https://teamsnodesample.azurewebsites.net/static/img/image5.png\\\",\\\"facts\\\":[{\\\"name\\\":\\\"Status\\\",\\\"value\\\":\\\"@@status@@\\\"},{\\\"name\\\":\\\"Workflow\\\",\\\"value\\\":\\\"@@workflow@@\\\"},{\\\"name\\\":\\\"Logs\\\",\\\"value\\\":\\\"@@log@@\\\"}],\\\"markdown\\\":true}]}\"}}"
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "The status code indicates that the core data migration process has begun. The asynchronous datacopy process produces an empty success response after it has started. The timely state of the data copy process can be obtained by configuring a webhook or by retrieving the data copy process status using a REST API.",
            "examples" : {
              "application/json" : "{}"
            }
          },
