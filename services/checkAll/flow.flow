interface api

service checkAll (
    input {
        String url;
    }
    output {
        String url;
        String host;
        String resolved_ip;
        String ping_reachable;
        String ping_response_time;
        String tcp_port;
        String tcp_open;
        String tcp_response_time;
        String http_status;
        String http_reachable;
        String http_error_msg;
    }
)
properties {
    comment: "Performs a full endpoint check: DNS resolution, ping, TCP connect, and HTTP GET. Returns all results combined.";
}
{
    INVOKE pub.flow:debugLog {
        input {
            mapSource {
                String url;
            }
            mapTarget {
                String message;
                String function;
                String level;
            }
            copy url -> message;
            set function = "checkAll";
            set level = "Info";
        }
    }
    INVOKE OEBB_Infra_Pro_AGWCheck.utils:parseUrl {
        input {
            mapSource {
                String url;
            }
            mapTarget {
                String url;
            }
            copy url -> url;
        }
        output {
            mapSource {
                String host;
                String port;
            }
            mapTarget {
                String parsedHost;
                String parsedPort;
            }
            copy host -> parsedHost;
            copy port -> parsedPort;
        }
    }
    INVOKE pub.flow:debugLog {
        input {
            mapSource {
                String parsedHost;
                String parsedPort;
            }
            mapTarget {
                String message;
                String function;
                String level;
            }
            copy parsedHost -> message;
            set function = "checkAll";
            set level = "Info";
        }
    }
    MAP {
        mapTarget {
            String pingTimeoutMs;
            String tcpTimeoutMs;
            String httpConnectTimeoutMs;
            String httpReadTimeoutMs;
            String httpSkipSsl;
        }
        set pingTimeoutMs = "2000";
        set tcpTimeoutMs = "2000";
        set httpConnectTimeoutMs = "10000";
        set httpReadTimeoutMs = "15000";
        set httpSkipSsl = "false";
    }
    INVOKE OEBB_Infra_Pro_AGWCheck.api:resolveHost {
        input {
            mapSource {
                String url;
            }
            mapTarget {
                String url;
            }
            copy url -> url;
        }
        output {
            mapSource {
                String host;
                String resolved_ip;
            }
            mapTarget {
                String resolvedHost;
                String resolved_ip;
            }
            copy host -> resolvedHost;
            copy resolved_ip -> resolved_ip;
        }
    }
    INVOKE pub.flow:debugLog {
        input {
            mapSource {
                String resolved_ip;
            }
            mapTarget {
                String message;
                String function;
                String level;
            }
            copy resolved_ip -> message;
            set function = "checkAll";
            set level = "Info";
        }
    }
    INVOKE OEBB_Infra_Pro_AGWCheck.api:checkPing {
        input {
            mapSource {
                String parsedHost;
                String pingTimeoutMs;
            }
            mapTarget {
                String host;
                String timeout;
            }
            copy parsedHost -> host;
            copy pingTimeoutMs -> timeout;
        }
        output {
            mapSource {
                String reachable;
                String response_time;
            }
            mapTarget {
                String ping_reachable;
                String ping_response_time;
            }
            copy reachable -> ping_reachable;
            copy response_time -> ping_response_time;
        }
    }
    INVOKE pub.flow:debugLog {
        input {
            mapSource {
                String ping_reachable;
            }
            mapTarget {
                String message;
                String function;
                String level;
            }
            copy ping_reachable -> message;
            set function = "checkAll";
            set level = "Info";
        }
    }
    INVOKE OEBB_Infra_Pro_AGWCheck.api:checkTcp {
        input {
            mapSource {
                String parsedHost;
                String parsedPort;
                String tcpTimeoutMs;
            }
            mapTarget {
                String host;
                String port;
                String timeout;
            }
            copy parsedHost -> host;
            copy parsedPort -> port;
            copy tcpTimeoutMs -> timeout;
        }
        output {
            mapSource {
                String open;
                String response_time;
            }
            mapTarget {
                String tcp_open;
                String tcp_response_time;
            }
            copy open -> tcp_open;
            copy response_time -> tcp_response_time;
        }
    }
    INVOKE pub.flow:debugLog {
        input {
            mapSource {
                String tcp_open;
            }
            mapTarget {
                String message;
                String function;
                String level;
            }
            copy tcp_open -> message;
            set function = "checkAll";
            set level = "Info";
        }
    }
    INVOKE OEBB_Infra_Pro_AGWCheck.api:checkHttp {
        input {
            mapSource {
                String url;
                String httpConnectTimeoutMs;
                String httpReadTimeoutMs;
                String httpSkipSsl;
            }
            mapTarget {
                String url;
                String conn_timeout;
                String read_timeout;
                String insecure;
            }
            copy url -> url;
            copy httpConnectTimeoutMs -> conn_timeout;
            copy httpReadTimeoutMs -> read_timeout;
            copy httpSkipSsl -> insecure;
        }
        output {
            mapSource {
                String http_status;
                String reachable;
                String error_msg;
            }
            mapTarget {
                String http_status;
                String http_reachable;
                String http_error_msg;
            }
            copy http_status -> http_status;
            copy reachable -> http_reachable;
            copy error_msg -> http_error_msg;
        }
    }
    INVOKE pub.flow:debugLog {
        input {
            mapSource {
                String http_status;
            }
            mapTarget {
                String message;
                String function;
                String level;
            }
            copy http_status -> message;
            set function = "checkAll";
            set level = "Info";
        }
    }
    MAP {
        mapSource {
            String parsedPort;
            String resolvedHost;
        }
        mapTarget {
            String host;
            String tcp_port;
        }
        copy resolvedHost -> host;
        copy parsedPort -> tcp_port;
    }
}
