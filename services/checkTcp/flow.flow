interface api

service checkTcp (
    input {
        String host;
        String port;
        String timeout;
    }
    output {
        String host;
        String port;
        String open;
        String response_time;
    }
)
properties {
    comment: "Tests TCP port connectivity by attempting a socket connection to the given host and port using Java's Socket.connect() with InetSocketAddress. The optional timeout parameter controls the connect timeout (default: 2000 ms). Returns open=true and the connection time in milliseconds on success, or open=false and response_time=-1 if the connection is refused or times out. Default port is 443 if the port parameter is omitted or unparseable.";
}
{
    INVOKE pub.flow:debugLog {
        input {
            mapSource {
                String host;
                String port;
            }
            mapTarget {
                String message;
                String function;
                String level;
            }
            copy host -> message;
            set function = "checkTcp";
            set level = "Info";
        }
    }
    TRY {
        INVOKE OEBB_Infra_Pro_AGWCheck.utils:tcpCheck {
            input {
                mapSource {
                    String host;
                    String port;
                    String timeout;
                }
                mapTarget {
                    String host;
                    String port;
                    String timeout;
                }
                copy host -> host;
                copy port -> port;
                copy timeout -> timeout;
            }
            output {
                mapSource {
                    String host;
                    String port;
                    String open;
                    String response_time;
                }
                mapTarget {
                    String host;
                    String port;
                    String open;
                    String response_time;
                }
                copy host -> host;
                copy port -> port;
                copy open -> open;
                copy response_time -> response_time;
            }
        }
        INVOKE pub.flow:debugLog {
            input {
                mapSource {
                    String open;
                    String response_time;
                }
                mapTarget {
                    String message;
                    String function;
                    String level;
                }
                copy open -> message;
                set function = "checkTcp";
                set level = "Info";
            }
        }
    }
    CATCH {
        INVOKE pub.flow:debugLog {
            input {
                mapTarget {
                    String message;
                    String function;
                    String level;
                }
                set message = "TCP check failed with exception";
                set function = "checkTcp";
                set level = "Error";
            }
        }
        MAP {
            mapTarget {
                String open;
                String response_time;
            }
            set open = "false";
            set response_time = "-1";
        }
    }
}
