interface api

service checkHttp (
    input {
        String url;
        String conn_timeout;
        String read_timeout;
        String insecure;
    }
    output {
        String url;
        String http_status;
        String reachable;
        String error_msg;
    }
)
properties {
    comment: "Issues an HTTP HEAD request to the given URL and returns the HTTP status code. Falls back to GET automatically if the server returns 405 Method Not Allowed. Connect and read timeouts default to 10000 ms and 15000 ms respectively and can be overridden via conn_timeout and read_timeout. Set insecure=true to disable SSL certificate and hostname verification for internal endpoints with self-signed certificates (uses a trust-all TLS context). Returns reachable=true for any HTTP response (status > 0), or reachable=false with error_msg populated if the connection fails. Compatible with webMethods IS 10.11 and 10.15 (Java 8).";
}
{
    INVOKE pub.flow:debugLog {
        input {
            mapSource {
                String url;
            }
            mapTarget {
                String message;
                String function;
                String level;
            }
            copy url -> message;
            set function = "checkHttp";
            set level = "Info";
        }
    }
    MAP {
        mapTarget {
            String effectiveConnectTimeout;
            String effectiveReadTimeout;
        }
        set effectiveConnectTimeout = "10000";
        set effectiveReadTimeout = "15000";
    }
    IF (%conn_timeout% != "") {
        MAP {
            mapSource {
                String conn_timeout;
            }
            mapTarget {
                String effectiveConnectTimeout;
            }
            copy conn_timeout -> effectiveConnectTimeout;
        }
    }
    IF (%read_timeout% != "") {
        MAP {
            mapSource {
                String read_timeout;
            }
            mapTarget {
                String effectiveReadTimeout;
            }
            copy read_timeout -> effectiveReadTimeout;
        }
    }
    MAP {
        mapTarget {
            String error_msg;
            String http_status;
            String reachable;
        }
        set error_msg = "";
        set http_status = "0";
        set reachable = "false";
    }
    TRY {
        INVOKE pub.client:http {
            input {
                mapSource {
                    String url;
                    String effectiveConnectTimeout;
                    String effectiveReadTimeout;
                    String insecure;
                }
                mapTarget {
                    String url;
                    String method;
                    String connectTimeout;
                    String timeout;
                    String hostNameVerification;
                }
                copy url -> url;
                set method = "get";
                copy effectiveConnectTimeout -> connectTimeout;
                copy effectiveReadTimeout -> timeout;
                copy insecure -> hostNameVerification;
            }
        }
        MAP {
            mapSource {
                record header {
                    String status;
                };
            }
            mapTarget {
                String http_status;
                String reachable;
            }
            copy header/status -> http_status;
            set reachable = "true";
        }
        INVOKE pub.flow:debugLog {
            input {
                mapSource {
                    String http_status;
                }
                mapTarget {
                    String message;
                    String function;
                    String level;
                }
                copy http_status -> message;
                set function = "checkHttp";
                set level = "Info";
            }
        }
    }
    CATCH {
        INVOKE pub.flow:debugLog {
            input {
                mapTarget {
                    String message;
                    String function;
                    String level;
                }
                set message = "HTTP GET failed with exception";
                set function = "checkHttp";
                set level = "Error";
            }
        }
        MAP {
            mapTarget {
                String error_msg;
                String reachable;
            }
            set error_msg = "HTTP request failed";
            set reachable = "false";
        }
    }
}
