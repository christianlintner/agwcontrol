interface api

service checkHttp (
    input {
        String url;
        String conn_timeout;
        String read_timeout;
        String insecure;
    }
    output {
        String url;
        String http_status;
        String reachable;
        String error_msg;
    }
)
properties {
    comment: "Performs an HTTP(S) GET to the given URL and returns the HTTP status code. SSL certificate validation can be disabled for internal endpoints. Compatible with wm10.11 and wm10.15.";
}
{
    INVOKE pub.flow:debugLog {
        input {
            mapSource {
                String url;
            }
            mapTarget {
                String message;
                String function;
                String level;
            }
            copy url -> message;
            set function = "checkHttp";
            set level = "Info";
        }
    }
    MAP {
        mapTarget {
            String effectiveConnectTimeout;
            String effectiveReadTimeout;
        }
        set effectiveConnectTimeout = "10000";
        set effectiveReadTimeout = "15000";
    }
    IF (%conn_timeout% != "") {
        MAP {
            mapSource {
                String conn_timeout;
            }
            mapTarget {
                String effectiveConnectTimeout;
            }
            copy conn_timeout -> effectiveConnectTimeout;
        }
    }
    IF (%read_timeout% != "") {
        MAP {
            mapSource {
                String read_timeout;
            }
            mapTarget {
                String effectiveReadTimeout;
            }
            copy read_timeout -> effectiveReadTimeout;
        }
    }
    MAP {
        mapTarget {
            String error_msg;
            String http_status;
            String reachable;
        }
        set error_msg = "";
        set http_status = "0";
        set reachable = "false";
    }
    TRY {
        INVOKE pub.client:http {
            input {
                mapSource {
                    String url;
                    String effectiveConnectTimeout;
                    String effectiveReadTimeout;
                    String insecure;
                }
                mapTarget {
                    String url;
                    String method;
                    String connectTimeout;
                    String timeout;
                    String hostNameVerification;
                }
                copy url -> url;
                set method = "get";
                copy effectiveConnectTimeout -> connectTimeout;
                copy effectiveReadTimeout -> timeout;
                copy insecure -> hostNameVerification;
            }
        }
        MAP {
            mapSource {
                record header {
                    String status;
                };
            }
            mapTarget {
                String http_status;
                String reachable;
            }
            copy header/status -> http_status;
            set reachable = "true";
        }
        INVOKE pub.flow:debugLog {
            input {
                mapSource {
                    String http_status;
                }
                mapTarget {
                    String message;
                    String function;
                    String level;
                }
                copy http_status -> message;
                set function = "checkHttp";
                set level = "Info";
            }
        }
    }
    CATCH {
        INVOKE pub.flow:debugLog {
            input {
                mapTarget {
                    String message;
                    String function;
                    String level;
                }
                set message = "HTTP GET failed with exception";
                set function = "checkHttp";
                set level = "Error";
            }
        }
        MAP {
            mapTarget {
                String error_msg;
                String reachable;
            }
            set error_msg = "HTTP request failed";
            set reachable = "false";
        }
    }
}
