interface api

service checkPing (
    input {
        String host;
        String timeout;
    }
    output {
        String host;
        String reachable;
        String response_time;
    }
)
properties {
    comment: "Tests ICMP reachability of a hostname or IP address using Java's InetAddress.isReachable(). The optional timeout parameter controls how long the probe waits before giving up (default: 2000 ms). Returns reachable=true and the round-trip time in milliseconds on success, or reachable=false and response_time=-1 if the host does not respond. Note: ICMP requires raw socket privileges — on Linux/Docker the container must have the NET_RAW capability, otherwise isReachable() silently falls back to TCP port 7 which is almost always closed.";
}
{
    INVOKE pub.flow:debugLog {
        input {
            mapSource {
                String host;
            }
            mapTarget {
                String message;
                String function;
                String level;
            }
            copy host -> message;
            set function = "checkPing";
            set level = "Info";
        }
    }
    TRY {
        INVOKE OEBB_Infra_Pro_AGWCheck.utils:ping {
            input {
                mapSource {
                    String host;
                    String timeout;
                }
                mapTarget {
                    String host;
                    String timeout;
                }
                copy host -> host;
                copy timeout -> timeout;
            }
            output {
                mapSource {
                    String host;
                    String reachable;
                    String response_time;
                }
                mapTarget {
                    String host;
                    String reachable;
                    String response_time;
                }
                copy host -> host;
                copy reachable -> reachable;
                copy response_time -> response_time;
            }
        }
        INVOKE pub.flow:debugLog {
            input {
                mapSource {
                    String reachable;
                    String response_time;
                }
                mapTarget {
                    String message;
                    String function;
                    String level;
                }
                copy reachable -> message;
                set function = "checkPing";
                set level = "Info";
            }
        }
    }
    CATCH {
        INVOKE pub.flow:debugLog {
            input {
                mapTarget {
                    String message;
                    String function;
                    String level;
                }
                set message = "Ping failed with exception";
                set function = "checkPing";
                set level = "Error";
            }
        }
        MAP {
            mapTarget {
                String reachable;
                String response_time;
            }
            set reachable = "false";
            set response_time = "-1";
        }
    }
}
